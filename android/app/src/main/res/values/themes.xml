<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tyfo" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/surface_container</item>
        <item name="colorOnPrimary">@color/on_surface</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Tyfo.AlertDialog</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.Tyfo.AlertDialog</item>
    </style>

    <style name="Theme.Tyfo.Settings" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dialog_action</item>
        <item name="colorOnPrimary">@color/on_surface</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Tyfo.AlertDialog</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.Tyfo.AlertDialog</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>

    <style name="Theme.Tyfo.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/surface_container</item>
        <item name="colorOnPrimary">@color/on_surface</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Tyfo.AlertDialog</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.Tyfo.AlertDialog</item>
    </style>

    <style name="Theme.Tyfo.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/surface_container</item>
        <item name="colorOnPrimary">@color/on_surface</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Tyfo.AlertDialog</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.Tyfo.AlertDialog</item>
    </style>

    <style name="ThemeOverlay.Tyfo.AlertDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorPrimary">@color/dialog_action</item>
        <item name="colorAccent">@color/dialog_action</item>
        <item name="android:colorAccent">@color/dialog_action</item>
    </style>

    <!-- Button style that respects android:background drawable -->
    <style name="Tyfo.Button.Custom" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <!-- Main screen and memory screen: the voice assistant's dark Monet style. Real colors come from
         MonetPalette (wallpaper) in code; these are the fallbacks before the first frame. -->
    <style name="Theme.Tyfo.Main" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/main_accent</item>
        <item name="colorAccent">@color/main_accent</item>
        <item name="android:windowBackground">@color/main_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Tyfo.Main.AlertDialog</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.Tyfo.Main.AlertDialog</item>
    </style>

    <style name="ThemeOverlay.Tyfo.Main.AlertDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorPrimary">@color/main_accent</item>
        <item name="colorAccent">@color/main_accent</item>
        <item name="android:colorAccent">@color/main_accent</item>
    </style>

    <!-- Side drawer rows -->
    <style name="Tyfo.DrawerItem" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Tyfo.DrawerItem.Icon" parent="">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Tyfo.DrawerItem.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
