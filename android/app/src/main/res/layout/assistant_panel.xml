<?xml version="1.0" encoding="utf-8"?>
<!-- Voice assistant (long-press power), Monet flat style. Panels carry a 16dp shadow margin,
     hence the negative margins: the visible panels sit 12dp from the screen edges and 10dp apart.
     Colors come from MonetPalette in code (dynamic Material You palette). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/assist_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="false">

    <LinearLayout
        android:id="@+id/assist_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="-4dp"
        android:layout_marginEnd="-4dp"
        android:orientation="vertical">

        <!-- Task in progress -->
        <ai.opencyvis.ui.fx.PanelFrameLayout
            android:id="@+id/assist_task_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-22dp"
            android:clickable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ai.opencyvis.ui.fx.AgentIconView
                        android:id="@+id/assist_task_icon"
                        android:layout_width="40dp"
                        android:layout_height="40dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/assist_task_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:singleLine="true"
                            android:textSize="15.5sp"
                            android:textStyle="bold"
                            tools:text="Turn on dark mode" />

                        <TextView
                            android:id="@+id/assist_task_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:textSize="12sp"
                            tools:text="Step 3 · running" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/assist_task_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.3"
                    android:maxLines="3"
                    android:textSize="13.5sp"
                    tools:text="Opening Settings to find the display page" />

                <ai.opencyvis.ui.fx.ProgressLineView
                    android:id="@+id/assist_task_progress"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <ai.opencyvis.ui.fx.IconTextButton
                        android:id="@+id/assist_task_view"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:drawablePadding="6dp"
                        android:drawableStart="@drawable/ic_ui_eye"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/island_open"
                        android:textSize="14sp" />

                    <ai.opencyvis.ui.fx.IconTextButton
                        android:id="@+id/assist_task_stop"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:drawablePadding="6dp"
                        android:drawableStart="@drawable/ic_ui_stop"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/overlay_stop"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </ai.opencyvis.ui.fx.PanelFrameLayout>

        <!-- Suggestions / choices: left-aligned to the pill's icon keyline, scrolls off the right edge -->
        <HorizontalScrollView
            android:id="@+id/assist_chips_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="-6dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="26dp"
            android:paddingEnd="16dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/assist_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Main pill -->
        <ai.opencyvis.ui.fx.PanelFrameLayout
            android:id="@+id/assist_pill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true">

            <LinearLayout
                android:id="@+id/assist_pill_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <ai.opencyvis.ui.fx.AgentIconView
                    android:id="@+id/assist_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/assist_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:lineSpacingMultiplier="1.1"
                        android:maxLines="4"
                        android:textSize="16sp"
                        tools:text="What should I do for you?" />

                    <EditText
                        android:id="@+id/assist_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="@string/assist_hint_typing"
                        android:imeOptions="actionSend|flagNoExtractUi"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="4"
                        android:minHeight="40dp"
                        android:paddingVertical="6dp"
                        android:textSize="16sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/assist_caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textSize="12.5sp"
                        android:visibility="gone"
                        tools:text="Handing it to OpenCyvis…"
                        tools:visibility="visible" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/assist_keyboard"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_assist_round_button"
                    android:contentDescription="@string/assist_cd_keyboard"
                    android:padding="10dp"
                    android:src="@drawable/ic_assist_keyboard" />

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="2dp">

                    <View
                        android:id="@+id/assist_mic_halo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0" />

                    <ImageView
                        android:id="@+id/assist_mic"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/assist_cd_mic"
                        android:padding="12dp"
                        android:src="@drawable/ic_assist_mic" />
                </FrameLayout>
            </LinearLayout>
        </ai.opencyvis.ui.fx.PanelFrameLayout>
    </LinearLayout>
</FrameLayout>
