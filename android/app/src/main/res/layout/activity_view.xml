<?xml version="1.0" encoding="utf-8"?>
<!-- Agent screen preview. Controls float at the bottom in the same Monet flat style as the task island and
     the voice assistant: a status pill that morphs into a control card. The panel carries a 16dp shadow
     margin, hence the negative side margins (the visible panel sits 12dp from the screen edges).
     Colors come from MonetPalette in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/view_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- SurfaceView renders VD content, fitted between the status bar and the nav bar -->
    <SurfaceView
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top|center_horizontal" />

    <EditText
        android:id="@+id/takeover_keyboard_proxy"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:alpha="0"
        android:background="@null"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:imeOptions="flagNoExtractUi" />

    <!-- Edge light (marquee): follows the agent state -->
    <ai.opencyvis.ui.fx.EdgeLightView
        android:id="@+id/glow_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Touch interceptor: blocks touches in VIEW mode, invisible -->
    <View
        android:id="@+id/touch_interceptor"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Back to chat: translucent round button over the preview's top-left (top margin set from insets) -->
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/vd_btn_back"
        android:padding="13dp"
        android:src="@drawable/ic_ui_back" />

    <ai.opencyvis.ui.fx.MorphPanelLayout
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="-4dp"
        android:layout_marginEnd="-4dp"
        android:clickable="true">

        <!-- Collapsed: status pill -->
        <ai.opencyvis.ui.fx.FadeLinearLayout
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <ai.opencyvis.ui.fx.AgentIconView
                android:id="@+id/fab_icon"
                android:layout_width="32dp"
                android:layout_height="32dp" />

            <TextView
                android:id="@+id/fab_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxWidth="240dp"
                android:singleLine="true"
                android:textSize="13sp"
                tools:text="Step 3 · Opening Settings" />
        </ai.opencyvis.ui.fx.FadeLinearLayout>

        <!-- Expanded: control card -->
        <ai.opencyvis.ui.fx.FadeLinearLayout
            android:id="@+id/bottom_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ai.opencyvis.ui.fx.AgentIconView
                    android:id="@+id/panel_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/panel_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:textSize="15.5sp"
                        android:textStyle="bold"
                        tools:text="Turn on dark mode" />

                    <TextView
                        android:id="@+id/panel_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textSize="12sp"
                        tools:text="Step 3 · running" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_collapse"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@string/island_collapse"
                    android:scaleType="center"
                    android:src="@drawable/ic_ui_chevron_down" />
            </LinearLayout>

            <TextView
                android:id="@+id/panel_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.3"
                android:maxLines="3"
                android:textSize="13.5sp"
                tools:text="Opening Settings to find the display page" />

            <!-- Sensitive-input handoff: privacy note, auto-return countdown -->
            <LinearLayout
                android:id="@+id/handoff_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/handoff_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/handoff_active_message"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/handoff_countdown_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/handoff_pending_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btn_handoff_now"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/handoff_return_now"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btn_handoff_cancel"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/handoff_cancel_return"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <ai.opencyvis.ui.fx.ProgressLineView
                android:id="@+id/panel_progress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="16dp" />

            <!-- Answer to the agent's question, or a supplement while it runs. Same pattern as the
                 assistant pill: one trailing button that is a mic when empty and send once typed. -->
            <LinearLayout
                android:id="@+id/input_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="4dp">

                <EditText
                    android:id="@+id/answer_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:imeOptions="actionSend|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="text|textCapSentences"
                    android:paddingVertical="12dp"
                    android:textSize="15sp"
                    tools:hint="@string/supplement_hint" />

                <!-- Mic when empty (accent while listening), send once there is text -->
                <ImageView
                    android:id="@+id/btn_send_answer"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/cd_voice_input"
                    android:padding="10dp"
                    android:src="@drawable/ic_assist_mic" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/control_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <ai.opencyvis.ui.fx.IconTextButton
                    android:id="@+id/btn_takeover"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:drawablePadding="6dp"
                    android:drawableStart="@drawable/ic_ui_cursor"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="@string/vd_btn_take_over"
                    android:textSize="14sp" />

                <ai.opencyvis.ui.fx.IconTextButton
                    android:id="@+id/btn_stop"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:drawablePadding="6dp"
                    android:drawableStart="@drawable/ic_ui_stop"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:singleLine="true"
                    android:text="@string/vd_btn_stop"
                    android:textSize="14sp" />
            </LinearLayout>
        </ai.opencyvis.ui.fx.FadeLinearLayout>
    </ai.opencyvis.ui.fx.MorphPanelLayout>
</FrameLayout>
