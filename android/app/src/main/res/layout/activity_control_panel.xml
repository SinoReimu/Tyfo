<?xml version="1.0" encoding="utf-8"?>
<!-- Main screen, in the voice assistant's Monet flat style: the conversation fills the page, the task card
     and the input pill float at the bottom (16dp shadow margin each, hence the negative margins), and a
     translucent round button at the top-left opens the side drawer (actions + history, like Gemini).
     Insets and colors are applied in ControlPanelActivity (MonetPalette). -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/main_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Conversation -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_chat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="18dp"
            android:paddingEnd="18dp" />

        <!-- New task: greeting -->
        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginBottom="96dp"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingEnd="30dp">

            <com.shiro.tyfo.ui.fx.AgentIconView
                android:id="@+id/empty_icon"
                android:layout_width="44dp"
                android:layout_height="44dp" />

            <TextView
                android:id="@+id/text_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-medium"
                android:textSize="32sp"
                tools:text="Good afternoon" />

            <TextView
                android:id="@+id/text_greeting_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/greeting_subtitle"
                android:textSize="21sp" />
        </LinearLayout>

        <!-- Fades the conversation out under the status bar and the drawer button -->
        <View
            android:id="@+id/top_scrim"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_gravity="top" />

        <!-- Opens the side drawer (top margin set from insets) -->
        <ImageView
            android:id="@+id/btn_drawer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/cd_open_drawer"
            android:padding="12dp"
            android:src="@drawable/ic_ui_menu" />

        <!-- Hides the conversation behind the bottom panel and the nav bar (height set in code) -->
        <View
            android:id="@+id/bottom_scrim"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="bottom" />

        <!-- Bottom: task card + input pill (bottom margin set from nav bar / IME insets) -->
        <LinearLayout
            android:id="@+id/bottom_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="-4dp"
            android:layout_marginEnd="-4dp"
            android:orientation="vertical">

            <com.shiro.tyfo.ui.fx.PanelFrameLayout
                android:id="@+id/task_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="-22dp"
                android:clickable="true"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp">

                    <com.shiro.tyfo.ui.fx.AgentIconView
                        android:id="@+id/task_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp" />

                    <TextView
                        android:id="@+id/text_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:textSize="14sp"
                        tools:text="Step 3 · running" />

                    <com.shiro.tyfo.ui.fx.IconTextButton
                        android:id="@+id/btn_view_operation"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:drawablePadding="6dp"
                        android:drawableStart="@drawable/ic_ui_eye"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/island_open"
                        android:textSize="13.5sp" />

                    <com.shiro.tyfo.ui.fx.IconTextButton
                        android:id="@+id/btn_stop"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:drawablePadding="6dp"
                        android:drawableStart="@drawable/ic_ui_stop"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/overlay_stop"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </com.shiro.tyfo.ui.fx.PanelFrameLayout>

            <!-- ask_user 的候选答案：点一个即作答，也可以照常在下面自己输入 -->
            <HorizontalScrollView
                android:id="@+id/option_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="6dp"
                android:clipToPadding="false"
                android:fadingEdgeLength="16dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:requiresFadingEdge="horizontal"
                android:scrollbars="none"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/option_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <com.shiro.tyfo.ui.fx.PanelFrameLayout
                android:id="@+id/input_pill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:minHeight="60dp"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="6dp">

                    <EditText
                        android:id="@+id/edit_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/main_hint_new"
                        android:imeOptions="actionSend|flagNoExtractUi"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:lineSpacingMultiplier="1.15"
                        android:maxLines="6"
                        android:minHeight="48dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:textSize="16sp" />

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp">

                        <View
                            android:id="@+id/mic_halo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:alpha="0" />

                        <ImageView
                            android:id="@+id/btn_send"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cd_voice_input"
                            android:padding="11dp"
                            android:src="@drawable/ic_assist_mic" />
                    </FrameLayout>
                </LinearLayout>
            </com.shiro.tyfo.ui.fx.PanelFrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Side drawer: actions, then the history -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:clickable="true"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/drawer_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:id="@+id/drawer_new_task"
                style="@style/Tyfo.DrawerItem">

                <ImageView
                    android:id="@+id/drawer_new_task_icon"
                    style="@style/Tyfo.DrawerItem.Icon"
                    android:src="@drawable/ic_ui_new_task" />

                <TextView
                    android:id="@+id/drawer_new_task_label"
                    style="@style/Tyfo.DrawerItem.Label"
                    android:text="@string/drawer_new_task" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/drawer_memory"
                style="@style/Tyfo.DrawerItem">

                <ImageView
                    android:id="@+id/drawer_memory_icon"
                    style="@style/Tyfo.DrawerItem.Icon"
                    android:src="@drawable/ic_ui_memory" />

                <TextView
                    android:id="@+id/drawer_memory_label"
                    style="@style/Tyfo.DrawerItem.Label"
                    android:text="@string/drawer_memory" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/drawer_settings"
                style="@style/Tyfo.DrawerItem">

                <ImageView
                    android:id="@+id/drawer_settings_icon"
                    style="@style/Tyfo.DrawerItem.Icon"
                    android:src="@drawable/ic_ui_settings" />

                <TextView
                    android:id="@+id/drawer_settings_label"
                    style="@style/Tyfo.DrawerItem.Label"
                    android:text="@string/drawer_settings" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/drawer_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/drawer_recent_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginBottom="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/drawer_recent"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_history"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:id="@+id/drawer_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="28dp"
                android:paddingTop="6dp"
                android:paddingEnd="28dp"
                android:text="@string/drawer_empty"
                android:textSize="13.5sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
